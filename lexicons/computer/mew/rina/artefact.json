{
  "lexicon": 1,
  "id": "computer.mew.rina.artefact",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["snapshot"],
        "properties": {
          "snapshot": {"type": "ref", "ref": "#snapshot"}
        }
      }
    },
    "snapshot": {
      "type": "object",
      "required": ["schemaVersion", "title", "kind", "createdAt", "updatedAt", "source", "metadata"],
      "properties": {
        "schemaVersion": {"type": "integer", "minimum": 1, "maximum": 1},
        "title": {"type": "string", "maxLength": 200},
        "kind": {"type": "string", "knownValues": ["document", "code", "web", "inlineWeb"]},
        "createdAt": {"type": "string", "format": "datetime"},
        "updatedAt": {"type": "string", "format": "datetime"},
        "source": {"type": "string", "maxLength": 1000000},
        "renderedContent": {"type": "string", "maxLength": 1000000},
        "metadata": {"type": "object", "maxProperties": 100, "additionalProperties": {"type": "string", "maxLength": 1000000}}
      }
    }
  }
}
